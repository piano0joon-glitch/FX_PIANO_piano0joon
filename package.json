{
  "name": "piano-puzzle-video-generator",
  "version": "0.1.0",
  "description": "MIDI-driven piano puzzle video generator",
  "main": "dist/main/electron-main.js",
  "type": "module",
  "scripts": {
  "dev:renderer": "vite --host 127.0.0.1",
  "dev:main": "tsc -p tsconfig.main.json --watch",
  "dev:electron": "wait-on http://127.0.0.1:5173 file:dist/main/electron-main.js && electron . --dev",
  "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",

  "build:main": "tsc -p tsconfig.main.json",
  "build": "npm run build:main && vite build",
  "start": "electron .",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "test": "vitest run --root ."
}

,
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "pixi.js": "^8.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.3"
  }
}
